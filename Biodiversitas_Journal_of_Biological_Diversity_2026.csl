<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US"
       demote-non-dropping-particle="sort-only">
  <info>
    <title>Biodiversitas Journal of Biological Diversity</title>
    <title-short>Biodiversitas</title-short>
    <id>http://www.zotero.org/styles/biodiversitas-journal-of-biological-diversity-custom-2026</id>
    <link href="http://www.zotero.org/styles/biodiversitas-journal-of-biological-diversity-custom-2026" rel="self"/>
    <link href="https://smujo.id/biodiv/guidance-for-author" rel="documentation"/>
    <category citation-format="author-date"/>
    <category field="biology"/>
    <issn>1412-033X</issn>
    <eissn>2085-4722</eissn>
    <summary>Custom CSL aligned with the Biodiversitas Journal of Biological Diversity author guidelines accessed in September 2026.</summary>
    <updated>2026-09-26T03:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License.</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short">ed</term>
      <term name="editor" form="short" plural="true">eds</term>
    </terms>
  </locale>

  <macro name="citation-author">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
      <substitute>
        <names variable="editor">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-sort">
    <names variable="author">
      <name name-as-sort-order="all"/>
      <substitute>
        <names variable="editor"><name name-as-sort-order="all"/></names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-bib">
    <names variable="author">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor">
          <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editors">
    <names variable="editor">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never"/>
      <label variable="editor" form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>

  <macro name="journal-details">
    <group>
      <text variable="container-title" form="short"/>
      <group prefix=" " delimiter=" ">
        <text variable="volume"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text variable="page" prefix=": "/>
    </group>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI"><text variable="DOI" prefix="DOI: https://doi.org/"/></if>
    </choose>
  </macro>

  <macro name="publisher">
    <group delimiter=", "><text variable="publisher"/><text variable="publisher-place"/></group>
  </macro>

  <macro name="thesis-type">
    <choose>
      <if variable="genre"><text variable="genre" prefix="[" suffix="]"/></if>
      <else><text value="[Thesis]"/></else>
    </choose>
  </macro>

  <citation disambiguate-add-year-suffix="true" collapse="year-suffix" after-collapse-delimiter="; ">
    <sort>
      <key variable="issued" sort="ascending"/>
      <key macro="author-sort" sort="ascending"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="citation-author"/>
        <date variable="issued"><date-part name="year"/></date>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="false" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author-sort" sort="ascending"/>
      <key variable="issued" sort="ascending"/>
      <key variable="title" sort="ascending"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author-bib"/>
            <text macro="year"/>
            <text variable="title"/>
            <text macro="journal-details"/>
            <text macro="doi"/>
          </group>
        </if>
        <else-if type="chapter">
          <group delimiter=". ">
            <text macro="author-bib"/>
            <text macro="year"/>
            <text variable="title"/>
            <group><text value="In: "/><text macro="editors"/></group>
            <text variable="container-title"/>
            <text macro="publisher"/>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="book">
          <group delimiter=". ">
            <text macro="author-bib"/>
            <text macro="year"/>
            <text variable="title"/>
            <text macro="publisher"/>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="paper-conference">
          <group delimiter=". ">
            <text macro="author-bib"/>
            <text macro="year"/>
            <text variable="title"/>
            <group><text value="In: "/><text macro="editors"/></group>
            <text variable="container-title"/>
            <text macro="publisher"/>
            <text variable="event-place"/>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="thesis">
          <group delimiter=". ">
            <text macro="author-bib"/>
            <text macro="year"/>
            <text variable="title"/>
            <text macro="thesis-type"/>
            <text macro="publisher"/>
            <text variable="URL"/>
          </group>
        </else-if>
        <else-if type="report dataset" match="any">
          <group delimiter=". ">
            <text macro="author-bib"/>
            <text macro="year"/>
            <text variable="title"/>
            <text macro="publisher"/>
            <text macro="doi"/>
            <text variable="URL"/>
          </group>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <group delimiter=". ">
            <text macro="author-bib"/>
            <text macro="year"/>
            <text variable="title"/>
            <text variable="publisher"/>
            <text variable="URL"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text macro="author-bib"/>
            <text macro="year"/>
            <text variable="title"/>
            <text variable="container-title" form="short"/>
            <text macro="publisher"/>
            <text macro="doi"/>
            <text variable="URL"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
